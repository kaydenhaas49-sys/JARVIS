# Copy to .env. Environment variables already set in your shell take precedence.
# Local-only by default. For Tailscale testing, set JARVIS_HOST to this machine's
# Tailscale IPv4 address (run: tailscale ip -4). For a whole-LAN bind use 0.0.0.0.
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8765

# Required when JARVIS_HOST is not a loopback address.
# Generate a private password with: python3 -c 'import secrets; print(secrets.token_urlsafe(24))'
# The password must be at least 16 characters. Never commit your real .env file.
JARVIS_ACCESS_USER=jarvis
JARVIS_ACCESS_PASSWORD=

# llama.cpp server default. LM Studio or Ollama can use their own OpenAI-compatible /v1 URL.
JARVIS_BASE_URL=http://127.0.0.1:8080/v1
JARVIS_MODEL=local-model
JARVIS_API_KEY=

# File tools are scoped to this folder; JARVIS creates it automatically.
JARVIS_WORKSPACE=~/JARVIS-workspace
